# Database
DATABASE_URL="mysql://user:password@host:3306/flambeau_progres"

# URL publique de l'app, telle que vue par le navigateur.
# Sert d'origine pour le retour vers wp-login.php et pour les liens des emails.
# Obligatoire derriere un reverse proxy : l'adresse d'ecoute interne du conteneur
# ne doit jamais apparaitre dans une URL. A defaut, x-forwarded-host / x-forwarded-proto.
APP_URL="http://localhost:3000"

# SMTP (emails) — serveur interne Flambeaux, sans authentification
SMTP_HOST=""
SMTP_PORT="25"
EMAIL_FROM="Flambeau Progrès <noreply@flambeaux.org>"
EMAIL_REPLY_TO="plateforme@flambeaux.org"

UPLOAD_DIR=""

WORDPRESS_URL="https://plateforme.flambeaux.org"
NEXT_PUBLIC_WORDPRESS_URL="https://plateforme.flambeaux.org"

# Autorise Flambeau Progres a ecrire la progression sur la plateforme WordPress
# (a passer a "true" une fois la route POST /wp-json/flbx/v1/user-info disponible)
WORDPRESS_PROGRESSION_WRITE=false
