generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CHEF
  REFERENT
  ADMIN
}

enum TypeObjectif {
  COMPETENCE
  REALISATION
}

enum StatutJustification {
  BROUILLON
  AUTO_VALIDEE
  SOUMISE
  EN_COURS
  DEMANDE_PRECISION
  VALIDEE
  REFUSEE
}

enum TypeFichier {
  IMAGE
  DOCUMENT
  AUTRE
}

enum TypeCommentaire {
  CHEF_REPONSE
  REFERENT_QUESTION
  REFERENT_FEEDBACK
  SYSTEM
}

enum TypeNotification {
  NOUVELLE_JUSTIFICATION
  JUSTIFICATION_VALIDEE
  JUSTIFICATION_REFUSEE
  DEMANDE_PRECISION
  REPONSE_PRECISION
  etape_COMPLETE
  JUSTIFICATION_URGENTE
  NOUVEAU_COMMENTAIRE
}

model Troupe {
  id             String  @id @default(cuid())
  nom            String
  chefDeTroupeId String? @unique

  chefDeTroupe User?  @relation("TroupeLeader", fields: [chefDeTroupeId], references: [id], onDelete: SetNull)
  membres      User[] @relation("TroupeMembres")

  @@map("troupes")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  image         String?
  emailVerified Boolean?
  role          UserRole @default(CHEF)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  troupeId      String?
  troupe        Troupe? @relation("TroupeMembres", fields: [troupeId], references: [id], onDelete: SetNull)
  troupeDirigee Troupe? @relation("TroupeLeader")

  commandesEmises etapeCommande[] @relation("ChefDeTroupeCommandes")
  commandesRecues etapeCommande[] @relation("ChefCommandes")

  justifications        Justification[]
  assignedetapes        etapeReferent[]
  commentsWritten       Commentaire[]   @relation("CommentaireAuteur")
  notificationsReceived Notification[]  @relation("NotificationDestinataire")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model etape {
  id          String   @id @default(cuid())
  number      String   @unique
  name        String
  description String
  image_src   String?
  ordre       Int
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objectifs        Objectif[]
  referents        etapeReferent[]
  justifications   Justification[]
  commandesDeetape etapeCommande[]

  @@map("etapes")
}

model Objectif {
  id             String       @id @default(cuid())
  etapeId        String
  code           String
  description    String
  type           TypeObjectif
  fichiersRequis Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  etape          etape           @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  justifications Justification[]

  @@unique([etapeId, code])
  @@map("objectifs")
}

model Justification {
  id         String  @id @default(cuid())
  chefId     String
  objectifId String
  etapeId    String
  contenu    String?

  statut    StatutJustification @default(BROUILLON)
  version   Int                 @default(1)
  soumiseAt DateTime?
  valideeAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  chef          User           @relation(fields: [chefId], references: [id], onDelete: Cascade)
  objectif      Objectif       @relation(fields: [objectifId], references: [id], onDelete: Cascade)
  etape         etape          @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  fichiers      Fichier[]
  commentaires  Commentaire[]
  notifications Notification[]

  @@unique([chefId, objectifId])
  @@map("justifications")
}

model etapeCommande {
  id             String @id @default(cuid())
  chefId         String
  etapeId        String
  chefDeTroupeId String

  completeAt DateTime  @default(now())
  commandeAt DateTime?

  chef         User  @relation("ChefCommandes", fields: [chefId], references: [id], onDelete: Cascade)
  etape        etape @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  chefDeTroupe User  @relation("ChefDeTroupeCommandes", fields: [chefDeTroupeId], references: [id], onDelete: Cascade)

  @@unique([chefId, etapeId])
  @@map("etape_commandes")
}

model Fichier {
  id              String      @id @default(cuid())
  justificationId String
  nomOriginal     String
  nomStockage     String
  cheminFichier   String
  type            TypeFichier
  mimeType        String
  taille          Int
  createdAt       DateTime    @default(now())

  justification Justification @relation(fields: [justificationId], references: [id], onDelete: Cascade)

  @@map("fichiers")
}

model Commentaire {
  id              String          @id @default(cuid())
  justificationId String
  auteurId        String
  contenu         String
  type            TypeCommentaire
  createdAt       DateTime        @default(now())

  justification Justification @relation(fields: [justificationId], references: [id], onDelete: Cascade)
  auteur        User          @relation("CommentaireAuteur", fields: [auteurId], references: [id], onDelete: Cascade)

  @@map("commentaires")
}

model etapeReferent {
  id         String   @id @default(cuid())
  referentId String
  etapeId    String
  assigneAt  DateTime @default(now())
  assignePar String?

  referent User  @relation(fields: [referentId], references: [id], onDelete: Cascade)
  etape    etape @relation(fields: [etapeId], references: [id], onDelete: Cascade)

  @@unique([referentId, etapeId])
  @@map("etape_referents")
}

model Notification {
  id              String           @id @default(cuid())
  destinataireId  String
  justificationId String?
  type            TypeNotification
  titre           String
  message         String
  lue             Boolean          @default(false)
  createdAt       DateTime         @default(now())
  lueAt           DateTime?

  destinataire  User           @relation("NotificationDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)
  justification Justification? @relation(fields: [justificationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
