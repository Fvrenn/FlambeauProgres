generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CHEF
  REFERENT
  ADMIN
}

enum TypeObjectif {
  COMPETENCE
  REALISATION
}

enum TypeEtape {
  JALON
  BADGE
}

enum StatutJustification {
  BROUILLON
  AUTO_VALIDEE
  SOUMISE
  DEMANDE_PRECISION
  VALIDEE
}

enum StatutChefEtape {
  NON_COMMENCE
  EN_COURS
  EN_REVISION
  VALIDE
}

enum TypeFichier {
  IMAGE
  DOCUMENT
  AUTRE
}

enum MessageType {
  USER
  SYSTEM
}

enum TypeNotification {
  NOUVELLE_JUSTIFICATION
  JUSTIFICATION_VALIDEE
  JUSTIFICATION_REFUSEE
  DEMANDE_PRECISION
  REPONSE_PRECISION
  ETAPE_COMPLETE
  JUSTIFICATION_URGENTE
  NOUVEAU_COMMENTAIRE
}

model User {
  id        String   @id @default(cuid())
  wpUserId  Int?     @unique
  email     String   @unique
  name      String
  image     String?
  role      UserRole @default(CHEF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  justifications        Justification[]
  assigneEtapes         EtapeReferent[]
  messagesWritten       Message[]       @relation("MessageAuteur")
  notificationsReceived Notification[]  @relation("NotificationDestinataire")

  statutsEtapes         ChefEtapeStatut[] @relation("ChefStatuts")
  validationsEffectuees ChefEtapeStatut[] @relation("ReferentValidations")

  realisationsValidees Justification[] @relation("ReferentJustificationValidations")

  @@map("users")
}

model Etape {
  id          String    @id @default(cuid())
  number      String    @unique
  name        String
  description String
  image_src   String?
  couleur     String?
  ordre       Int
  niveau      Int       @default(2)
  type        TypeEtape @default(BADGE)
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  objectifs      Objectif[]
  referents      EtapeReferent[]
  justifications Justification[]

  statutsChefs ChefEtapeStatut[]

  @@map("etapes")
}

model FormationCard {
  id        String   @id @default(cuid())
  titre     String
  imageUrl  String   @db.Text
  lien      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("formation_cards")
}

model ChefEtapeStatut {
  id           String          @id @default(cuid())
  chefId       String
  etapeId      String
  statut       StatutChefEtape @default(EN_COURS)
  valideeAt    DateTime?
  valideeParId String?

  chef       User  @relation("ChefStatuts", fields: [chefId], references: [id], onDelete: Cascade)
  etape      Etape @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  valideePar User? @relation("ReferentValidations", fields: [valideeParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chefId, etapeId])
  @@map("chef_etape_statuts")
}

model Objectif {
  id             String       @id @default(cuid())
  etapeId        String
  code           String
  description    String
  type           TypeObjectif
  fichiersRequis Boolean      @default(false)
  texteRequis    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  etape          Etape           @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  justifications Justification[]

  @@unique([etapeId, code])
  @@map("objectifs")
}

model Justification {
  id         String  @id @default(cuid())
  chefId     String
  objectifId String
  etapeId    String
  contenu    String?

  statut       StatutJustification @default(BROUILLON)
  soumiseAt    DateTime?
  valideeAt    DateTime?
  valideeParId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  chef          User           @relation(fields: [chefId], references: [id], onDelete: Cascade)
  objectif      Objectif       @relation(fields: [objectifId], references: [id], onDelete: Cascade)
  etape         Etape          @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  valideePar    User?          @relation("ReferentJustificationValidations", fields: [valideeParId], references: [id], onDelete: SetNull)
  fichiers      Fichier[]
  messages      Message[]
  notifications Notification[]

  @@unique([chefId, objectifId])
  @@map("justifications")
}

model Fichier {
  id              String      @id @default(cuid())
  messageId       String      @unique
  justificationId String
  nomOriginal     String
  nomStockage     String
  cheminFichier   String
  type            TypeFichier
  mimeType        String
  taille          Int
  createdAt       DateTime    @default(now())

  message       Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  justification Justification @relation(fields: [justificationId], references: [id], onDelete: Cascade)

  @@map("fichiers")
}

model Message {
  id              String      @id @default(cuid())
  justificationId String
  auteurId        String
  contenu         String?
  type            MessageType @default(USER)
  createdAt       DateTime    @default(now())

  justification Justification @relation(fields: [justificationId], references: [id], onDelete: Cascade)
  auteur        User          @relation("MessageAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
  fichier       Fichier?

  @@map("messages")
}

model EtapeReferent {
  id         String   @id @default(cuid())
  referentId String
  etapeId    String
  assigneAt  DateTime @default(now())
  assignePar String?

  referent User  @relation(fields: [referentId], references: [id], onDelete: Cascade)
  etape    Etape @relation(fields: [etapeId], references: [id], onDelete: Cascade)

  @@unique([referentId, etapeId])
  @@map("etape_referents")
}

model Notification {
  id              String           @id @default(cuid())
  destinataireId  String
  justificationId String?
  type            TypeNotification
  titre           String
  message         String
  lue             Boolean          @default(false)
  createdAt       DateTime         @default(now())
  lueAt           DateTime?

  destinataire  User           @relation("NotificationDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)
  justification Justification? @relation(fields: [justificationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
